{
  "name": "NBA 2K Jersey Modder Companion Editor",
  "version": 1,
  "theme": {
    "colorScheme": "dark",
    "fontFamily": ["Segoe UI", "Arial", "sans-serif"],
    "colors": {
      "appBackground": "#171a20",
      "canvasWorkspace": "#11141a",
      "canvasSurface": "#20242b",
      "header": "#222833",
      "inspector": "#1d222c",
      "panel": "#202632",
      "secondaryControl": "#303746",
      "border": "#343b49",
      "strongBorder": "#475064",
      "primaryText": "#edf1f7",
      "headingText": "#f8fafc",
      "secondaryText": "#d7deeb",
      "mutedText": "#aab3c2",
      "subtleText": "#99a5b8",
      "primaryAction": "#f0b429",
      "primaryActionText": "#171a20",
      "returnAction": "#168579",
      "successAction": "#2f7655",
      "dangerAction": "#6a2f35"
    },
    "dimensions": {
      "headerHeight": 48,
      "pathHeaderHeight": 52,
      "inspectorWidth": 330,
      "inspectorMinWidth": 300,
      "inspectorMaxWidth": 390,
      "headerPadding": 14,
      "inspectorPadding": 12,
      "controlGap": 8,
      "controlRadius": 6,
      "panelRadius": 6,
      "resizeHandleDocumentSize": 56,
      "resizeHandleHitRadius": 58
    }
  },
  "canvas": {
    "wheelZoom": true,
    "pointerCenteredZoom": true,
    "middleMousePan": true,
    "shiftDragPan": true,
    "fitCommand": true,
    "emptyCanvasDeselects": true,
    "alphaAwareSelection": true,
    "alphaHitThreshold": 12,
    "topmostLayerWins": true,
    "independentWidthHeight": true,
    "rotation": true,
    "arrowNudgePixels": 1,
    "shiftArrowNudgePixels": 10,
    "persistOnPointerRelease": true,
    "drawScheduler": "requestAnimationFrame"
  },
  "layers": {
    "flatOrderedList": true,
    "selectionSyncedWithCanvas": true,
    "reorder": true,
    "visibility": true,
    "flip": true,
    "nonDestructiveCleanup": true,
    "capabilityDrivenControls": true,
    "separateDerivedLayers": true,
    "linkedMovement": true,
    "unlink": true
  },
  "cleanup": {
    "autoBackground": true,
    "removeWhite": true,
    "removeBlack": true,
    "outsideOnly": true,
    "toleranceMinimum": 0,
    "toleranceMaximum": 255,
    "defaultTolerance": 32
  },
  "pathDrawing": {
    "defaultShape": "straight",
    "shapes": ["straight", "smooth", "t"],
    "tJunctionModes": ["open", "closed"],
    "defaultTJunctionMode": "open",
    "angleSnapDegrees": [0, 1, 5, 15, 45],
    "altBypassesSnap": true,
    "rightClickFinishes": true,
    "escapeFinishes": true,
    "liveAngleReadout": true,
    "liveLengthReadout": true,
    "editablePatternWidth": true,
    "editablePatternScale": true,
    "editablePatternOffset": true,
    "uvGuide": true,
    "separateTransparentPngPerLayer": true
  },
  "desktopBridge": {
    "bindHost": "127.0.0.1",
    "transport": "HTTP",
    "statePollingMilliseconds": 400,
    "atomicStateWrites": true,
    "stateEnvelope": ["revision", "returnRequested", "project"],
    "desktopOwns": ["projects", "fileDialogs", "persistence", "exports"],
    "browserOwns": ["canvasInteraction", "livePreview", "temporarySelectionState"]
  },
  "performance": {
    "retainOriginalPixels": true,
    "cacheDecodedImages": true,
    "cacheBustOnRevisionOnly": true,
    "clientSideDragPreview": true,
    "updateAfterInteraction": true,
    "onePixelAlphaHitCanvas": true,
    "neverResampleFromPreview": true
  }
}
