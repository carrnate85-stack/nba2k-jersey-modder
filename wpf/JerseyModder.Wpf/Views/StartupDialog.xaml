<Window x:Class="JerseyModder.Wpf.Views.StartupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NBA 2K Jersey Modder" Width="640" Height="350" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="76"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Image Source="pack://application:,,,/Assets/app-icon.png" Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="NBA 2K Jersey Modder" FontSize="25" FontWeight="SemiBold"/>
        <TextBlock Text="Start a new uniform project or continue an existing one." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Height="92" Margin="0,24,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Style="{StaticResource PrimaryButton}" Margin="0" Padding="16,12" Click="OnNew" AutomationProperties.Name="New Project">
        <StackPanel>
          <TextBlock Text="New Project" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="Create an organized folder for assets and exports." FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Opacity=".85"/>
        </StackPanel>
      </Button>
      <Button Grid.Column="2" Margin="0" Padding="16,12" Click="OnOpen" AutomationProperties.Name="Open Project">
        <StackPanel>
          <TextBlock Text="Open Project" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="Continue an existing NBA 2K Jersey Modder project." FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
      </Button>
    </Grid>

    <Grid Grid.Row="3" Margin="0,20,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="1" Content="Continue without a project" Margin="0" Padding="13,7" Click="OnContinue"/>
      <TextBlock Grid.Column="2" x:Name="VersionText" Text="Version 1.0.0" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
  </Grid>
</Window>
