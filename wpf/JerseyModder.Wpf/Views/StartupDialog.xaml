<Window x:Class="JerseyModder.Wpf.Views.StartupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NBA 2K Jersey Modder" Width="620" Height="390" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="30">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Image Source="/JerseyModder.Wpf;component/Assets/app-icon.png" Width="92" Height="92" Stretch="Uniform" HorizontalAlignment="Left"/>
    <StackPanel Grid.Row="1" Margin="0,14,0,22">
      <TextBlock Text="NBA 2K Jersey Modder" FontSize="27" FontWeight="SemiBold"/>
      <TextBlock Text="Start a new uniform project or continue an existing one." Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,6,0,0"/>
    </StackPanel>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Button Style="{StaticResource PrimaryButton}" Margin="0,0,7,0" Padding="18" Click="OnNew">
        <StackPanel><TextBlock Text="New Project" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Create a project folder with organized assets and exports." Margin="0,7,0,0" TextWrapping="Wrap" Opacity=".85"/></StackPanel>
      </Button>
      <Button Grid.Column="1" Margin="7,0,0,0" Padding="18" Click="OnOpen">
        <StackPanel><TextBlock Text="Open Project" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Load an existing NBA 2K Jersey Modder project." Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/></StackPanel>
      </Button>
    </Grid>
    <Grid Grid.Row="3" Margin="0,22,0,0">
      <Button Content="Continue without a project" HorizontalAlignment="Center" Click="OnContinue"/>
      <TextBlock x:Name="VersionText" Text="Version 1.0.0" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
  </Grid>
</Window>
