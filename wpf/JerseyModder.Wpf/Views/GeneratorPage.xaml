<views:ToolPageBase x:Class="JerseyModder.Wpf.Views.GeneratorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:JerseyModder.Wpf.Views" xmlns:controls="clr-namespace:JerseyModder.Wpf.Controls">
  <Grid Margin="18,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Generator" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="Build jersey and shorts color textures from reusable template zones." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,12"/>
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="410"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
          <Expander Header="Template" IsExpanded="True"><Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12">
            <StackPanel>
              <CheckBox x:Name="UvEnabled" Content="Show UV overlay" Checked="OnUvChanged" Unchecked="OnUvChanged"/>
              <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                <TextBlock Text="Opacity" VerticalAlignment="Center" Margin="0,0,8,0"/><Slider x:Name="UvOpacity" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="OnUvChanged"/><TextBlock x:Name="UvValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
              <Button Style="{StaticResource PrimaryButton}" Content="Generate Preview" Margin="0,10,0,0" Click="OnGenerate"/>
            </StackPanel>
          </Border></Expander>
          <Expander Header="Colors" Margin="0,6,0,0"><Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12"><StackPanel x:Name="ColorPanel"/></Border></Expander>
          <Expander Header="Images" Margin="0,6,0,0"><Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12"><StackPanel x:Name="ImagePanel"/></Border></Expander>
          <Expander x:Name="WaistbandSection" Header="Waistband" Margin="0,6,0,0"><Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12"><TextBlock Text="Waistband color and image are available above. The image remains above the waistband color." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/></Border></Expander>
          <Expander Header="Logos" Margin="0,6,0,0"><Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12"><StackPanel>
            <ComboBox x:Name="LogoType" Margin="0,0,0,8"/><ListBox x:Name="LogoList" Height="112" DisplayMemberPath="label"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="Add Logo" Click="OnAddLogo"/><Button Content="Remove" Click="OnRemoveLogo"/></StackPanel>
          </StackPanel></Border></Expander>
          <Expander Header="Trim Paths" Margin="0,6,0,0"><Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12"><StackPanel><TextBlock x:Name="TrimPathSummary" Foreground="{StaticResource MutedBrush}"/><Button Content="Open Trim Path Lab" Margin="0,8,0,0" Click="OnOpenPaths"/></StackPanel></Border></Expander>
          <Expander Header="Preview Number" Margin="0,6,0,0"><Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12"><StackPanel>
            <CheckBox x:Name="NumberEnabled" Content="Show number in previews only" Checked="OnNumberChanged" Unchecked="OnNumberChanged"/>
            <TextBox x:Name="NumberText" Margin="0,8,0,0" MaxLength="4" TextChanged="OnNumberChanged"/>
          </StackPanel></Border></Expander>
        </StackPanel>
      </ScrollViewer>
      <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Button Grid.Row="0" Style="{StaticResource PrimaryButton}" Content="Open Native Layer Editor" Margin="0,0,0,8" Click="OnLayerEditor"/>
        <Grid Grid.Row="1"><TextBlock x:Name="PreviewStatus" Text="Preparing preview..." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><Button Content="Fit" HorizontalAlignment="Right" Padding="10,4" Click="OnFit"/></Grid>
        <controls:ImageViewport x:Name="Preview" Grid.Row="2"/>
      </Grid>
    </Grid>
  </Grid>
</views:ToolPageBase>
