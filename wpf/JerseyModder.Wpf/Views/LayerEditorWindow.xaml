<Window x:Class="JerseyModder.Wpf.Views.LayerEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:JerseyModder.Wpf.Controls"
        Title="Jersey Modder - Layer Editor" Width="1380" Height="860" MinWidth="960" MinHeight="620" WindowStartupLocation="CenterOwner" PreviewKeyDown="OnKeyDown">
  <Grid Margin="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Layer Editor" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Select a layer, then position and size it without locking width to height." Foreground="{StaticResource MutedBrush}"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Refresh Preview" Click="OnRefresh"/><Button Content="Reset Selected" Click="OnReset"/><Button Style="{StaticResource PrimaryButton}" Content="Done" Click="OnDone"/></StackPanel>
    </Grid>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
      <controls:ImageViewport x:Name="Preview" Margin="0,0,12,0"/>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel>
        <GroupBox Header="Preview">
          <StackPanel><CheckBox x:Name="UvEnabled" Content="UV overlay" Click="OnUv"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="Opacity" VerticalAlignment="Center"/><Slider x:Name="UvOpacity" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="OnUv"/><TextBlock x:Name="UvText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></StackPanel>
        </GroupBox>
        <GroupBox Header="Layers"><ListBox x:Name="LayerList" Height="245" SelectionChanged="OnLayerSelected" DisplayMemberPath="Name"/></GroupBox>
        <GroupBox Header="Transform"><StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,5,8"><TextBlock Text="X position"/><TextBox x:Name="XValue" LostFocus="OnTransform"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="5,0,0,8"><TextBlock Text="Y position"/><TextBox x:Name="YValue" LostFocus="OnTransform"/></StackPanel>
          </Grid>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,5,8"><TextBlock Text="Width %"/><TextBox x:Name="WidthValue" LostFocus="OnTransform"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="5,0,0,8"><TextBlock Text="Height %"/><TextBox x:Name="HeightValue" LostFocus="OnTransform"/></StackPanel>
          </Grid>
          <TextBlock Text="Rotation"/><TextBox x:Name="RotationValue" Margin="0,0,0,8" LostFocus="OnTransform"/>
          <TextBlock Text="Arrow keys nudge the selected layer. Hold Shift for 10 pixels." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        </StackPanel></GroupBox>
        <GroupBox Header="Background cleanup"><StackPanel><CheckBox x:Name="AutoBackground" Content="Auto background"/><CheckBox x:Name="RemoveWhite" Content="Remove white"/><CheckBox x:Name="RemoveBlack" Content="Remove black"/><CheckBox x:Name="OutsideOnly" Content="Outside only" IsChecked="True"/><Button Content="Apply to selected layer" Margin="0,8,0,0" Click="OnCleanup"/></StackPanel></GroupBox>
      </StackPanel></ScrollViewer>
    </Grid>
  </Grid>
</Window>
