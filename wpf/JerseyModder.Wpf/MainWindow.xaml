<Window x:Class="JerseyModder.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NBA 2K Jersey Modder" Icon="Assets/app-icon.ico" Width="1500" Height="920" MinWidth="1050" MinHeight="680"
        WindowStartupLocation="CenterScreen" Closing="OnClosing">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="226"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="20,20,16,18" BorderBrush="#34444A" BorderThickness="0,0,0,1">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Image Source="/JerseyModder.Wpf;component/Assets/app-icon.png" Width="43" Height="43" Stretch="Uniform" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="NBA 2K" Foreground="#58C9BA" FontWeight="Bold" FontSize="12" />
              <TextBlock Text="Jersey Modder" Foreground="White" FontWeight="SemiBold" FontSize="20" Margin="0,2,0,0" />
              <TextBlock Text="Uniform workspace" Foreground="#83959A" FontSize="11" Margin="0,3,0,0" />
            </StackPanel>
          </Grid>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,14">
          <Expander Header="Advanced" Foreground="#C9D5D2" Margin="2,0,2,8">
            <StackPanel Margin="0,5,0,0">
              <RadioButton Style="{StaticResource NavButton}" Content="IFF Textures" Tag="iff" Checked="OnNavigation" />
              <RadioButton Style="{StaticResource NavButton}" Content="RDAT Editor" Tag="rdat" Checked="OnNavigation" />
              <RadioButton Style="{StaticResource NavButton}" Content="Template Editor" Tag="template" Checked="OnNavigation" />
            </StackPanel>
          </Expander>
          <TextBlock Text="WPF + Python engine" Foreground="#71848A" FontSize="10" Margin="10,2" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,10,0,10">
            <RadioButton x:Name="GeneratorNav" Style="{StaticResource NavButton}" Content="Generator" Tag="generator" IsChecked="True" Checked="OnNavigation" />
            <RadioButton Style="{StaticResource NavButton}" Content="Logo Creator" Tag="logo" Checked="OnNavigation" />
            <RadioButton Style="{StaticResource NavButton}" Content="Trim Creator" Tag="trim" Checked="OnNavigation" />
            <RadioButton Style="{StaticResource NavButton}" Content="Trim Path Lab" Tag="paths" Checked="OnNavigation" />
            <RadioButton Style="{StaticResource NavButton}" Content="Number Editor" Tag="number" Checked="OnNavigation" />
            <RadioButton Style="{StaticResource NavButton}" Content="Tweak Editor" Tag="tweak" Checked="OnNavigation" />
            <RadioButton Style="{StaticResource NavButton}" Content="Texture Creator" Tag="texture" Checked="OnNavigation" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
      <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/><ColumnDefinition Width="120"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="ProjectName" Text="Untitled project" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="ProjectState" Text="Ready" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,8,0">
            <TextBlock Text="Garment" Foreground="{StaticResource MutedBrush}" FontSize="10" />
            <ComboBox x:Name="GarmentPicker" SelectionChanged="OnGarmentChanged"><ComboBoxItem Content="Jersey"/><ComboBoxItem Content="Shorts"/></ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="0,0,10,0">
            <TextBlock Text="Template" Foreground="{StaticResource MutedBrush}" FontSize="10" />
            <ComboBox x:Name="TemplatePicker" SelectionChanged="OnTemplateChanged" />
          </StackPanel>
          <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Content="New" ToolTip="Start a new project" Click="OnNew"/>
            <Button Content="Open" ToolTip="Open project" Click="OnOpen"/>
            <Button Content="Save" ToolTip="Save project" Click="OnSave"/>
            <Button Content="Export Package" ToolTip="Export all current game textures" Click="OnExport"/>
          </StackPanel>
          <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Web Layer Editor" ToolTip="Open the browser layer editor" Click="OnLayerEditor"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Blender Preview" ToolTip="Open or refresh the 3D preview" Click="OnBlender"/>
          </StackPanel>
        </Grid>
      </Border>
      <ContentControl x:Name="PageHost" Grid.Row="1" />
      <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,5">
        <Grid><TextBlock x:Name="StatusText" Text="Starting workspace..." Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="v1 WPF" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="11"/></Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
